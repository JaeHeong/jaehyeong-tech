# API: copy to apps/api/.env for local development.
DATABASE_URL=postgresql://techblog:techblog@localhost:5432/jaehyeong_tech
PORT=3000
NODE_ENV=development
TENANT_ID=tenant-jaehyeong-tech

# RS256 PEM keys; escaped newlines are accepted.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ADMIN_EMAILS=

# Optional shared cache; an unavailable cache never blocks origin reads.
REDIS_URL=redis://localhost:6379
CACHE_NAMESPACE=jaehyeong-tech
REDIS_COMMAND_TIMEOUT_MS=150
REDIS_RETRY_DELAY_MS=5000

# Optional OCI uploads and backups.
OCI_TENANCY=
OCI_USER=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY=
OCI_REGION=ap-chuncheon-1
OCI_BUCKET_NAME=
OCI_BACKUP_BUCKET_NAME=
CDN_DOMAIN=

# Optional GA4 reporting.
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=
