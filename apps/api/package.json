    "bcryptjs": "^2.4.3",
    "google-auth-library": "^9.0.0",
    "dotenv": "^16.4.0",
    "slugify": "^1.6.6",
    "@google-analytics/data": "^5.2.1",
    "multer": "^1.4.5-lts.1",
    "oci-objectstorage": "^2.90.0",
    "oci-common": "^2.90.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.11",
    "prisma": "^6.1.0",
